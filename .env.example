GEMINI_API_KEY=your_google_ai_studio_key_here

# ── OTP Email (auth/) ──────────────────────────────────────
# Gmail: use App Password (not your normal password)
#   1. Google Account → Security → 2-Step Verification ON
#   2. App passwords → Mail → generate 16-char password
#
# Prefer port 587 (STARTTLS). If you get STARTTLS errors, try 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_mailbox@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_mailbox@gmail.com
SMTP_USE_TLS=true
